# ==========================================
# External Database Connection (PostgreSQL)
# ==========================================
# Replace the URL below with your actual connection string from Neon, Supabase, Render, etc.
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://username:password@hostname:5432/traveloop?sslmode=require"

# ==========================================
# Authentication
# ==========================================
# Change this to a secure random string for production
JWT_SECRET="traveloop-super-secret-jwt-key-2024"

# ==========================================
# Server Configuration
# ==========================================
PORT=3001
